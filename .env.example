# Local development values, and the template `pnpm run env:init` copies to `.env`.
# Nothing here is a secret: it configures a throwaway container holding seeded demo data.
# The mockup IS deployed — hosted, with a pull-based deploy holding no credential in CI (decision
# of 17/08/2026). None of that configuration is in this file: it is built in Phase 8 of
# docs/BUILD-PLAN.md, with its own variables and its own ADRs.
# `pnpm run env:check` fails if this file, `.env` and compose.yml drift apart.

POSTGRES_USER=erp_migration
POSTGRES_PASSWORD=erp_local_dev
POSTGRES_DB=erp
POSTGRES_PORT=5433

APP_DB_USER=erp_app
APP_DB_PASSWORD=erp_local_dev

# Least-privilege role: what the API uses.
DATABASE_URL=postgres://erp_app:erp_local_dev@localhost:5433/erp
# Schema owner: what the migration runner uses, and nothing else. Migrations are numbered `.sql`
# files applied by a script — there is no ORM and no migration tool (ADR-0011).
MIGRATION_DATABASE_URL=postgres://erp_migration:erp_local_dev@localhost:5433/erp

API_PORT=3000
