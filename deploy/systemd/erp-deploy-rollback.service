[Unit]
Description=Maquette ERP - manual rollback to the previous digest (ADR-0029)
After=docker.service
ConditionPathExists=/etc/erp-maquette/environment

[Service]
Type=oneshot
WorkingDirectory=/opt/erp-maquette/repo/deploy
EnvironmentFile=/etc/erp-maquette/environment
ExecStart=/opt/erp-maquette/repo/deploy/pull-and-redeploy.sh --rollback
