node_modules/
dist/
build/
coverage/
.next/
.env
.env.*
!.env.example
*.log
.DS_Store
.idea/

# Playwright's own output (apps/web/playwright.config.ts): traces, retries, the HTML report.
# `tests/visual/review/` is NOT here — those screenshots are for human review (rule 0bis.10 of
# docs/frontend-plan.md) and are meant to be committed.
apps/web/tests/visual/test-results/
apps/web/tests/visual/report/
apps/web/.playwright-cache/

# Stryker's own working directory and the HTML mutation report it writes (ADR-0027, Phase 7):
# regenerated by every `pnpm exec stryker run`, never a deliverable on its own.
.stryker-tmp/
reports/

# Editor settings ARE versioned (see .vscode/settings.json): without eslint.workingDirectories
# and the workspace TypeScript, the guards do not behave the same for every reader.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Agent definitions ARE versioned: a reviewer that only one machine can run reviews nothing.
# Everything else Claude Code writes here is session state (RESUME.md and its checkpoint ref).
.claude/*
!.claude/agents/

# Generated agent onboarding notes, restating what CLAUDE.md and docs/BUILD-RULES.md already
# state. Ignored rather than versioned so the inventory keeps one source per rule.
AGENTS.md

# The working documents. Purged from history by ADR-0014 and archived in the private
# Maquette-ERP-notes repository; ignored here so a stray `git add .` cannot bring them back.
CHOIX.md
draft.md

# The construction journal: withdrawn from the tree on 08/09/2026 and kept privately (ADR-0120).
# Unlike CHOIX.md above, these are NOT purged from history — the ADR says so out loud. Ignored so a
# stray `git add .` cannot put them back in the tree.
docs/plan-roles-rh-direction.md
docs/todo.md
docs/qa-rounds.md
docs/qa-round-6-notes.md
docs/ssr-printables-sunset.md
docs/PHASE-4-5-CLOSURE.md
docs/audit-produit-ui-ux.md
docs/plan-densification.md
docs/vulnerability-management.md

# Reference screenshots pasted in for a QA round: read locally, never published. The repo is
# public (ADR-0086), and a screenshot of a third-party product is not ours to redistribute.
docs/images/

# Private working notes kept alongside the repo but never published: interview prep, salary
# figures, the client's name. The repository is public (ADR-0086) and deliberately anonymised
# ("a cybersecurity consulting firm"); `*.local.md` exists so a stray `git add .` cannot undo that.
*.local.md
