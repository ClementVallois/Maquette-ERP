# Local development values. Copy to `.env` with `pnpm run env:init`.
# Nothing here is a secret: this stack holds seeded demo data and is never deployed.

POSTGRES_USER=erp_migration
POSTGRES_PASSWORD=erp_local_dev
POSTGRES_DB=erp
POSTGRES_PORT=5433

APP_DB_USER=erp_app
APP_DB_PASSWORD=erp_local_dev

# Least-privilege role: what the API uses.
DATABASE_URL=postgres://erp_app:erp_local_dev@localhost:5433/erp
# Schema owner: what drizzle-kit uses, and nothing else.
MIGRATION_DATABASE_URL=postgres://erp_migration:erp_local_dev@localhost:5433/erp

API_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000
