{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // Vite's config and Playwright's config live next to `src/`, not under it — the base
    // `rootDir: "src"` would put both outside the program and fail with TS6059. `apps/api` never
    // needed this override because it has no config files of its own inside its tsconfig's scope.
    "rootDir": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
