# Local development values, and the template `pnpm run env:init` copies to `.env`.
# Nothing here is a secret, and two of these variables are the kind of thing that is one
# elsewhere: the database password configures a throwaway container holding seeded demo data, and
# SESSION_SIGNING_KEY below is a literal placeholder. In production both come from the host's
# root-owned systemd EnvironmentFile — never from this repository, never from CI (Phase 8).
# This file configures local development only. The hosted mockup uses a separate root-owned systemd
# EnvironmentFile whose variables are documented by Phase 8 deployment files, never copied from
# this file (ADR-0028). CI builds the deployable but receives none of those values.
# `pnpm run env:check` fails if this file, `.env` and compose.yml drift apart.

POSTGRES_USER=erp_migration
POSTGRES_PASSWORD=erp_local_dev
POSTGRES_DB=erp
POSTGRES_PORT=5433

APP_DB_USER=erp_app
APP_DB_PASSWORD=erp_local_dev

# Least-privilege role: what the API uses.
DATABASE_URL=postgres://erp_app:erp_local_dev@localhost:5433/erp
# Schema owner: what the migration runner uses, and nothing else. Migrations are numbered `.sql`
# files applied by a script — there is no ORM and no migration tool (ADR-0011).
MIGRATION_DATABASE_URL=postgres://erp_migration:erp_local_dev@localhost:5433/erp

# The API refuses to start if any of these is missing, and its refusal names the variable and
# what it expects — never the value it received.
API_HOST=127.0.0.1
API_PORT=3000

# Scheme and host, no trailing slash. A state-changing request whose `Origin` is anything else is
# refused: that plus `SameSite=Strict` is the CSRF stance (ADR-0023).
#
# There is no CORS and there will be none, so this value follows the **browser's** origin, which is
# not the same in the two topologies of ADR-0063 (front-end plan Phase 0.3, Phase 9.5):
#
#   - dev  — Vite is the browser's origin and proxies `/api`, `/facture`, `/releve`, `/healthz` and
#            `/readyz` to the API on 3000. Set API_PUBLIC_ORIGIN=http://127.0.0.1:5173, and run two
#            terminals: `pnpm run api:dev` and `pnpm --filter @erp/web dev`.
#   - prod/demo — Fastify serves `apps/web/dist` itself, one origin for the SPA and the API alike.
#            Keep the value below, or the public origin of the deployed instance. Build first:
#            `pnpm --filter @erp/web build`, then `pnpm run api`.
#
# The value below is the prod/demo one, because that is the topology `pnpm run setup` leaves a
# reader in — a dev session changes this line and nothing else.
#
# It must agree with API_HOST above, character for character. `localhost` and `127.0.0.1` are the
# same machine and are NOT the same origin: with the server bound to 127.0.0.1 and this set to
# localhost, the URL the server prints on startup answers 403 /problems/forbidden-origin on every
# write, and the reader who typed it has no way to tell why.
API_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Signs the persona cookie (HMAC-SHA-256). A placeholder, deliberately readable as one — the
# deployed instance reads its own from the host, and never from here.
SESSION_SIGNING_KEY=local-development-placeholder-not-a-secret

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
