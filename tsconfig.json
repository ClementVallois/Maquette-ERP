{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Covers repository tooling only. Without this level, config files and scripts escape both
  // the type checker and type-aware linting.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["*.config.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
